# Discord webhook URLs are read only by the Node server and must never be exposed to client-side code.
CAREERS_DISCORD_WEBHOOK_URL=
CONTACT_DISCORD_WEBHOOK_URL=

# Production HTTPS origin, for example https://www.your-domain.com
SITE_URL=

# Set true only behind a trusted reverse proxy that overwrites client IP headers.
TRUST_PROXY=false

# Optional local port (defaults to 3000)
PORT=3000
